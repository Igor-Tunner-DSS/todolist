PORT=3333
DB_HOST=
DB_PORT=
DB_USER=
DB_PASSWORD=
DB_NAME=
# Origem permitida para o CORS (endereço do frontend). O cookie de sessão exige uma origem exata.
CORS_ORIGIN=http://localhost:5173
# Para onde o backend redireciona o navegador depois do consentimento do Google
FRONTEND_URL=http://localhost:5173
# true em produção (HTTPS): marca o cookie de sessão como Secure
COOKIE_SECURE=false
# false desativa o cadastro de novos usuários
SIGNUP_ENABLED=true

# --- Google Calendar (integração somente leitura) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Deve ser IDÊNTICA a uma "URI de redirecionamento autorizada" no Google Cloud Console
GOOGLE_REDIRECT_URI=http://localhost:3333/api/integrations/google/callback
# Chave AES-256 (32 bytes) que criptografa os tokens no banco. Gere com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Guarde-a como segredo: perdê-la invalida as conexões (os usuários precisam reconectar).
TOKEN_ENCRYPTION_KEY=
